{
    "name": "laravel/symfony-on-cloud",
    "description": "Laravel Cloud integration for Symfony — run Laravel Cloud Managed Queues on top of Symfony Messenger.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "aws/aws-sdk-php": "^3.0",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/event-dispatcher": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0",
        "symfony/messenger": "^7.0 || ^8.0",
        "symfony/uid": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\Cloud\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravel\\Cloud\\Symfony\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
